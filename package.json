{
  "name": "bunsenworship",
  "productName": "BunsenWorship",
  "desktopName": "bunsenworship.desktop",
  "version": "1.0.16",
  "description": "BunsenWorship is an Electron application for managing worship presentations.",
  "main": "dist/main/main.js",
  "package": "com.bunsenplus.worship",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Ishimwe-William/bunsenworship.git"
  },
  "homepage": "https://github.com/Ishimwe-William/bunsenworship#readme",
  "bugs": {
    "url": "https://github.com/Ishimwe-William/bunsenworship/issues"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "install:dotnet": "powershell -ExecutionPolicy Bypass -File helper/install-dotnet-sdk.ps1",
    "build:helper": "powershell -ExecutionPolicy Bypass -File helper/build-helper.ps1",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "build:all": "npm run install:dotnet && npm run build:helper && npm run build",
    "package": "npm run build:all && electron-builder --win --publish never",
    "make": "npm run build:all && electron-builder",
    "publish": "npm run build:all && electron-builder --publish always",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "generate:icons": "electron scripts/generate-icons.js",
    "release": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "build": {
    "appId": "com.bunsenplus.worship",
    "productName": "BunsenWorship",
    "files": [
      "dist/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helper/build/PowerPointHelper.exe",
        "to": "PowerPointHelper.exe"
      }
    ],
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BunsenWorship",
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "buildResources/installerSidebar.bmp",
      "uninstallerSidebar": "buildResources/installerSidebar.bmp",
      "include": "buildResources/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "src/assets/AppIcon-512.png",
      "category": "AudioVideo",
      "syncDesktopName": true
    },
    "directories": {
      "output": "dist-release"
    },
    "publish": {
      "provider": "github",
      "owner": "Ishimwe-William",
      "repo": "bunsenworship",
      "releaseType": "release",
      "timeout": 600000
    }
  },
  "keywords": [
    "worship",
    "presentation",
    "electron",
    "application"
  ],
  "author": {
    "name": "William Ishimwe",
    "email": "ishimwe.william2000@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "adm-zip": "^0.6.1",
    "chokidar": "^5.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  }
}
